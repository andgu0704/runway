{
  "expo": {
    "name": "Runway",
    "slug": "runway",
    "version": "0.1.0",
    "scheme": "runway",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.runway.game",
      "supportsTablet": false
    },
    "android": {
      "package": "com.runway.game",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F0E8",
          "dark": {
            "backgroundColor": "#1C1A17"
          },
          "imageWidth": 160
        }
      ],
      "expo-status-bar",
      "expo-localization",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
